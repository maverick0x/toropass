# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/toropass?schema=public"

# API authentication
APP_API_KEY="replace-with-shared-api-key"
APP_SECRET="replace-with-hmac-secret"
JWT_SECRET="replace-with-jwt-secret"
BVN_HASH_PEPPER="replace-with-at-least-32-random-characters"

# Toronet SDK
BLOCKCHAIN_NETWORK="testnet" # or "mainnet"

TESTNET_ADMIN_ADDRESS="replace-with-testnet-admin-wallet-address"
TESTNET_ADMIN_PASSWORD="replace-with-testnet-admin-wallet-password"

MAINNET_ADMIN_ADDRESS="replace-with-mainnet-admin-wallet-address"
MAINNET_ADMIN_PASSWORD="replace-with-mainnet-admin-wallet-password"

# Runtime
PORT="3000"
NODE_ENV="development"

# Optional notifications
SLACK_WEBHOOK_URL=""
